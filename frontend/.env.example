# Frontend build-time environment (Vite). All optional.
#
# API base resolution (src/services/apiBase.ts):
#   1. VITE_API_BASE if set
#   2. production build (npm run build) -> same origin as the SPA + /anpr_backend
#   3. dev (npm run dev)                -> http://127.0.0.1/anpr_backend
#
# So a prod build served by the same Apache as the backend needs NO env file.
# Only set this when the API lives on a different host than the SPA:
# VITE_API_BASE=https://your-domain/anpr_backend
