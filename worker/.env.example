# ANPR MQTT Worker — copy to .env (gitignored) and adjust for your environment.

# --- DEV (laptop) ---
# MQTT broker (raw TCP, not WebSocket — paho-mqtt speaks native MQTT)
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_USERNAME=admin
MQTT_PASSWORD=admin123
MQTT_CLIENT_ID=anpr_worker

# PHP backend
BACKEND_URL=http://127.0.0.1/anpr_backend

# --- PRODUCTION (uncomment + edit) ---
# Prod topology: broker on 10.10.33.143 port 8171 (raw MQTT), webservices
# (Apache backend + SPA) on 10.10.33.144. Browsers reach the same broker
# via wss://wss-sigap.dpr.go.id:9901/mqtt.
# MQTT_BROKER=mqtt://10.10.33.143:8171
# MQTT_USERNAME=sigap
# MQTT_PASSWORD=MPAdmin@123
# MQTT_CLIENT_ID=anpr_worker_prod
# BACKEND_URL=http://10.10.33.144/anpr_backend

# --- Tuning (defaults shown) ---
# UVIS-timeout cron sweep frequency (seconds)
TICK_INTERVAL_S=5

# Cache refresh frequency for settings/channels (seconds)
SETTINGS_POLL_S=10
CHANNELS_POLL_S=30

# Skip duplicate plates seen within this window (seconds)
DEDUPE_WINDOW_S=10

# Channel used when an ANPR device SN is NOT mapped to any channel
FALLBACK_CHANNEL=RJ001

# HTTP request timeout (seconds)
HTTP_TIMEOUT_S=10
